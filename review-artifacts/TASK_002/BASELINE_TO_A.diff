+function activeTrackerModal() {
+  return modalFocusStack.at(-1)?.modal || null;
+}
+
+function modalControls(modal) {
+  return $all("button:not(:disabled), a[href], input:not(:disabled), select:not(:disabled), textarea:not(:disabled), [tabindex]:not([tabindex='-1'])", modal)
+    .filter((control) => !control.closest("[hidden], [inert]") && control.getClientRects().length);
+}
+
+function syncModalBackground() {
+  const active = activeTrackerModal();
+  if (active) {
+    for (const child of document.body.children) {
+      if (["SCRIPT", "STYLE", "LINK", "DIALOG"].includes(child.tagName) || child.id === "toast") continue;
+      if (!modalBackgroundInert.has(child)) modalBackgroundInert.set(child, child.inert);
+      child.inert = child !== active;
+    }
+  } else {
+    for (const [child, inert] of modalBackgroundInert) child.inert = inert;
+    modalBackgroundInert.clear();
+    document.body.style.overflow = modalBodyOverflow;
+  }
+}
+
+function activateSettingsTab(tab, focus = false) {
+  const tabs = $all("#settingsModal .tab-btn");
+  tabs.forEach((button) => {
+    const active = button === tab;
+    button.id = button.id || "settings-tab-" + button.dataset.tab;
+    button.setAttribute("role", "tab");
+    button.setAttribute("aria-selected", String(active));
+    button.setAttribute("aria-controls", button.dataset.tab);
+    button.tabIndex = active ? 0 : -1;
+    button.classList.toggle("active", active);
+    const panel = document.getElementById(button.dataset.tab);
+    panel.setAttribute("role", "tabpanel");
+    panel.setAttribute("aria-labelledby", button.id);
+    panel.tabIndex = 0;
+    panel.hidden = !active;
+    panel.classList.toggle("active", active);
+  });
+  if (focus) tab.focus();
+}
+
 function openModal(id) {
   const modal = document.getElementById(id);
+  if (!modal || modalFocusStack.some((entry) => entry.modal === modal)) return;
   modalReturnFocus = document.activeElement;
+  if (!modalFocusStack.length) {
+    modalBodyOverflow = document.body.style.overflow;
+    document.body.style.overflow = "hidden";
+  }
+  modalFocusStack.push({ modal, opener: modalReturnFocus });
   modal.hidden = false;
+  syncModalBackground();
   mountDotGridInModal(modal);
   refreshIcons();
+  modalControls(modal)[0]?.focus({ preventScroll: true });
 }
 
 function closeModal(id) {
+  const index = modalFocusStack.findIndex((entry) => entry.modal.id === id);
+  if (index < 0) return;
+  const [{ opener }] = modalFocusStack.splice(index, 1);
   document.getElementById(id).hidden = true;
   if (id === "dashboardModal") {
     dashboardProfileEditing = false;
     resetDashboardProfileDraft();
   }
   restoreDotGridHost();
+  syncModalBackground();
+  modalReturnFocus = opener;
   if (modalReturnFocus?.isConnected) modalReturnFocus.focus();
   modalReturnFocus = null;
 }
