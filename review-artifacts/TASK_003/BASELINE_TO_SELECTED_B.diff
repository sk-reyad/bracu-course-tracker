+function openStreamCategoryTooltip(trigger) {
+  closeStreamCategoryTooltips();
+  const tooltip = trigger.nextElementSibling;
+  if (!tooltip) return;
+  const placeholder = document.createComment("stream tooltip");
+  tooltip.before(placeholder);
+  document.body.append(tooltip);
+  tooltip.id = tooltip.id || "stream-popover-" + (++streamPopoverId);
+  tooltip.setAttribute("data-stream-open", "");
+  trigger.setAttribute("aria-controls", tooltip.id);
+  trigger.setAttribute("aria-expanded", "true");
+  trigger.classList.add("tooltip-open");
+  activeStreamPopover = { trigger, tooltip, placeholder };
+  const anchor = trigger.getBoundingClientRect();
+  const width = document.documentElement.clientWidth;
+  const height = window.innerHeight;
+  tooltip.style.maxWidth = Math.max(0, width - 24) + "px";
+  const measured = tooltip.getBoundingClientRect();
+  const left = Math.max(12, Math.min(anchor.left, width - measured.width - 12));
+  const top = Math.max(12, anchor.top >= measured.height + 20
+    ? anchor.top - measured.height - 8
+    : Math.min(anchor.bottom + 8, height - measured.height - 12));
+  tooltip.style.left = left + "px";
+  tooltip.style.top = top + "px";
+}
